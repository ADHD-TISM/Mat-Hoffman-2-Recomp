# Whitelist: only the project's own source is tracked.
# Never commit game data: the disc, the game image, generated code (gen*/ embed
# or translate game code), VU1 code snapshots, builds, logs, screenshots.
/*
!/.gitignore
!/README.md
!/mhrecomp/
!/launcher/

/mhrecomp/*
!/mhrecomp/NOTES.md
!/mhrecomp/build.sh
!/mhrecomp/regen.sh
!/mhrecomp/extra_ee.txt
!/mhrecomp/vu_recipe.json
!/mhrecomp/runtime/
!/mhrecomp/tools/
!/mhrecomp/gen_vu/
/mhrecomp/gen_vu/*
!/mhrecomp/gen_vu/*.pcs
/mhrecomp/tools/__pycache__/

/launcher/*
!/launcher/mh2launcher.py
!/launcher/build_exe.sh
!/launcher/test_launcher.py
